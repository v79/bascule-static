# Default: normalize everything to LF in the repo
* text=auto eol=lf

# Shell scripts must always be LF
*.sh text eol=lf
gradlew text eol=lf

# Windows batch/cmd files must always be CRLF
*.bat text eol=crlf
gradlew.bat text eol=crlf

# Source files — LF is fine everywhere
*.kt text eol=lf
*.kts text eol=lf
*.java text eol=lf

# Binary files — don't touch them at all
*.jar binary
*.png binary

